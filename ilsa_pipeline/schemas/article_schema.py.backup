"""
ILSA Literature Review - Pydantic Schema for GPT-4o Structured Outputs
"""

from typing import Literal, Optional
from pydantic import BaseModel, Field


class BibliographicInfo(BaseModel):
    """Core publication metadata."""
    title: Optional[str] = Field(None, description="Full article title exactly as printed.")
    authors: Optional[list[str]] = Field(None, description="Author full names in publication order.")
    publication_year: Optional[int] = Field(None, description="Year of publication (4 digits).")
    venue: Optional[str] = Field(None, description="Journal, conference, or report series name.")
    venue_type: Optional[Literal["journal", "conference", "book_chapter", "thesis", "technical_report", "working_paper", "preprint", "unknown"]] = Field(None, description="Type of publication venue.")
    doi: Optional[str] = Field(None, description="DOI in format 10.xxxx/xxxxx, no URL prefix.")
    url: Optional[str] = Field(None, description="Direct access URL if DOI not available.")
    open_access: Optional[bool] = Field(None, description="Whether the article is openly accessible.")


class ILSAContext(BaseModel):
    """Which large-scale assessment, year, countries, target population."""
    assessments_used: Optional[list[Literal["PISA", "TIMSS", "PIRLS", "TALIS", "ICILS", "ICCS", "PIAAC", "OTHER"]]] = Field(None, description="ILSA datasets analyzed in this study.")
    assessment_cycles: Optional[list[str]] = Field(None, description="Cycle years analyzed, e.g. ['2018', '2022']. Use empty list if longitudinal across all cycles.")
    target_domain: Optional[list[Literal["mathematics", "reading", "science", "ICT_literacy", "civic_knowledge", "adult_competencies", "teacher_practices", "financial_literacy", "creative_thinking", "other"]]] = Field(None, description="Cognitive or affective domains examined.")
    countries_analyzed: Optional[list[str]] = Field(None, description="ISO country names. Use ['ALL'] if all participating countries were included; use ['CROSS_COUNTRY'] for comparative analyses without enumeration.")
    country_count: Optional[int] = Field(None, description="Number of countries/economies in the analysis.")
    target_population: Optional[Literal["students_15yo", "students_grade4", "students_grade8", "teachers", "principals", "adults_16_65", "mixed", "other"]] = Field(None, description="Primary unit of analysis population.")
    sample_size: Optional[int] = Field(None, description="Total N in the analytic sample after exclusions.")


class MethodologicalHandling(BaseModel):
    """How the study handled survey complexity."""
    weights_applied: Optional[Literal["student_weights", "school_weights", "senate_weights", "balanced_repeated_replication", "jackknife", "no_weights_reported", "not_applicable", "unclear"]] = Field(None, description="Sampling weights treatment.")
    plausible_values_handling: Optional[Literal["all_PVs_pooled_rubins_rules", "single_PV_used", "averaged_PVs", "not_applicable", "unclear"]] = Field(None, description="How plausible values were treated.")
    missing_data_strategy: Optional[Literal["listwise_deletion", "pairwise_deletion", "multiple_imputation", "single_imputation", "model_based_native_handling", "missing_indicator_method", "full_information_ML", "not_reported", "not_applicable"]] = Field(None, description="Approach to missing data.")
    multilevel_structure: Optional[Literal["ignored_flat_model", "two_level_student_school", "three_level_student_school_country", "fixed_effects_country", "random_effects_country", "cluster_robust_SE", "not_applicable", "unclear"]] = Field(None, description="How nested student-school-country hierarchy was modeled.")
    multilevel_handled_explicitly: Optional[bool] = Field(None, description="True if the authors explicitly addressed the hierarchical/clustered nature of ILSA data.")


class MLMethodology(BaseModel):
    """Algorithms, evaluation, and explainability."""
    task_type: Optional[list[Literal["regression", "binary_classification", "multiclass_classification", "clustering", "dimensionality_reduction", "time_series_forecasting", "anomaly_detection", "association_rule_mining", "process_data_modeling", "NLP_text_mining", "correlational_analysis", "descriptive_only", "other"]]] = Field(None, description="ML task(s) performed.")
    algorithms_used: Optional[list[str]] = Field(None, description="All algorithms by canonical name.")
    deep_learning_used: Optional[bool] = Field(None, description="True if any neural network architecture is used.")
    deep_learning_architectures: Optional[list[str]] = Field(None, description="DL architectures if any.")
    feature_engineering: Optional[str] = Field(None, description="Brief description of features constructed.")
    train_test_strategy: Optional[Literal["k_fold_cv", "stratified_k_fold_cv", "holdout_split", "country_stratified_split", "leave_one_country_out", "temporal_split", "not_reported", "not_applicable"]] = Field(None, description="Validation scheme.")
    hyperparameter_tuning: Optional[Literal["grid_search", "random_search", "bayesian_optimization", "optuna_TPE", "manual", "default_values", "not_reported", "not_applicable"]] = Field(None, description="Hyperparameter optimization method.")


class PerformanceMetrics(BaseModel):
    """Quantitative evaluation results."""
    classification_metrics: Optional[list[Literal["accuracy", "precision", "recall", "F1", "AUC_ROC", "AUC_PR", "kappa", "MCC", "balanced_accuracy"]]] = Field(None, description="Classification metrics reported.")
    regression_metrics: Optional[list[Literal["RMSE", "MAE", "MAPE", "R_squared", "adjusted_R_squared", "MSE", "explained_variance"]]] = Field(None, description="Regression metrics reported.")
    best_model: Optional[str] = Field(None, description="Algorithm that performed best per the authors.")
    best_score: Optional[str] = Field(None, description="Headline performance with metric name.")
    benchmark_comparison: Optional[bool] = Field(None, description="True if ML models were compared against a baseline.")


class XAIUsage(BaseModel):
    """Explainability and interpretability methods."""
    xai_used: Optional[bool] = Field(None, description="Whether any XAI/interpretability method was applied.")
    xai_methods: Optional[list[Literal["SHAP", "LIME", "permutation_importance", "partial_dependence_plots", "ICE_plots", "feature_importance_native", "counterfactuals", "anchors", "attention_visualization", "decision_tree_surrogate", "rule_extraction", "other"]]] = Field(None, description="XAI methods used.")
    global_vs_local: Optional[Literal["global_only", "local_only", "both", "not_applicable"]] = Field(None, description="Scope of explanations provided.")
    top_features_identified: Optional[list[str]] = Field(None, description="Top 5-10 most important predictors identified by XAI.")


class FindingsAndPolicy(BaseModel):
    """Substantive findings and policy implications."""
    key_findings: Optional[list[str]] = Field(None, description="3-6 substantive findings about education dynamics.")
    inequality_dimensions_addressed: Optional[list[Literal["socioeconomic_status", "gender", "immigrant_background", "language_at_home", "rural_urban", "school_resources", "between_country", "within_country", "ethnic_minority", "special_needs", "none_addressed"]]] = Field(None, description="Equity dimensions the paper engages with.")
    policy_recommendations: Optional[list[str]] = Field(None, description="Concrete, actionable policy recommendations.")
    target_decision_makers: Optional[list[Literal["ministries_of_education", "school_administrators", "teachers", "curriculum_designers", "international_organizations", "researchers", "parents_students", "policymakers_general", "unclear"]]] = Field(None, description="Audience for the policy recommendations.")
    limitations_acknowledged: Optional[list[str]] = Field(None, description="Limitations the authors explicitly state.")


class ArticleExtraction(BaseModel):
    """Complete structured extraction for a single ILSA-AI article."""
    bibliographic: BibliographicInfo
    ilsa_context: ILSAContext
    methodology: MethodologicalHandling
    ml_methodology: MLMethodology
    performance: PerformanceMetrics
    xai: XAIUsage
    findings: FindingsAndPolicy
    extraction_confidence: Optional[Literal["high", "medium", "low"]] = Field(None, description="Self-assessed confidence in the extraction.")
    is_genuine_ilsa_ai_study: Optional[bool] = Field(None, description="Set to False if the article only mentions ILSA in passing or if no ML/AI methods are used.")
    extraction_notes: Optional[str] = Field(None, description="Brief free-text notes for human reviewers.")
