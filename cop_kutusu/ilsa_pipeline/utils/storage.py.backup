"""
Three-layer storage for extraction results.
"""

from __future__ import annotations
import json
import logging
import sqlite3
from pathlib import Path
import pandas as pd
from schemas.article_schema import ArticleExtraction
from extractors.gpt_extractor import ExtractionResult

logger = logging.getLogger(__name__)


def save_json(result: ExtractionResult, output_dir: Path) -> Path:
    output_dir.mkdir(parents=True, exist_ok=True)
    stem = Path(result.file_name).stem
    json_path = output_dir / f"{stem}.json"
    
    payload = {
        "file_name": result.file_name,
        "success": result.success,
        "input_tokens": result.input_tokens,
        "output_tokens": result.output_tokens,
        "cost_usd": result.cost_usd,
        "duration_seconds": result.duration_seconds,
        "error": result.error,
        "extraction": result.extraction.model_dump() if result.extraction else None,
    }
    json_path.write_text(json.dumps(payload, indent=2, ensure_ascii=False))
    return json_path


def flatten_extraction(extraction: ArticleExtraction, file_name: str) -> dict:
    d = extraction.model_dump()
    flat = {"file_name": file_name}
    for section_key, section_val in d.items():
        if isinstance(section_val, dict):
            for inner_key, inner_val in section_val.items():
                flat[f"{section_key}__{inner_key}"] = inner_val
        else:
            flat[section_key] = section_val
    return flat


def build_master_parquet(json_dir: Path, parquet_path: Path) -> pd.DataFrame:
    rows = []
    for json_file in sorted(json_dir.glob("*.json")):
        try:
            data = json.loads(json_file.read_text())
        except json.JSONDecodeError:
            logger.warning(f"Skipping malformed JSON: {json_file}")
            continue
        
        if not data.get("success") or data.get("extraction") is None:
            rows.append({
                "file_name": data.get("file_name"),
                "extraction_success": False,
                "error": data.get("error"),
                "input_tokens": data.get("input_tokens", 0),
                "output_tokens": data.get("output_tokens", 0),
                "cost_usd": data.get("cost_usd", 0.0),
            })
            continue
        
        extraction = ArticleExtraction(**data["extraction"])
        flat = flatten_extraction(extraction, data["file_name"])
        flat["extraction_success"] = True
        flat["error"] = None
        flat["input_tokens"] = data.get("input_tokens", 0)
        flat["output_tokens"] = data.get("output_tokens", 0)
        flat["cost_usd"] = data.get("cost_usd", 0.0)
        rows.append(flat)
    
    df = pd.DataFrame(rows)
    parquet_path.parent.mkdir(parents=True, exist_ok=True)
    df.to_parquet(parquet_path, index=False, compression="snappy")
    logger.info(f"Wrote {len(df)} rows to {parquet_path}")
    return df


def build_sqlite_database(parquet_path: Path, db_path: Path) -> None:
    df = pd.read_parquet(parquet_path)
    db_path.parent.mkdir(parents=True, exist_ok=True)
    if db_path.exists():
        db_path.unlink()
    
    conn = sqlite3.connect(db_path)
    
    def _is_listlike(x):
        if x is None or isinstance(x, (str, bytes)):
            return False
        try:
            iter(x)
            return True
        except TypeError:
            return False
    
    list_columns = set()
    for col in df.columns:
        non_null = df[col].dropna()
        if len(non_null) == 0:
            continue
        if non_null.apply(_is_listlike).any():
            list_columns.add(col)
    
    scalar_df = df.copy()
    for col in list_columns:
        scalar_df[col] = scalar_df[col].apply(
            lambda x: json.dumps(list(x), ensure_ascii=False) if _is_listlike(x) else None
        )
    scalar_df.to_sql("articles", conn, index=False, if_exists="replace")
    conn.execute("CREATE INDEX idx_articles_file ON articles(file_name)")
    
    def explode_to_junction(col_name: str, table_name: str, value_col: str):
        if col_name not in df.columns:
            return
        rows = []
        for _, row in df.iterrows():
            vals = row.get(col_name)
            if vals is None:
                continue
            try:
                if isinstance(vals, float) and pd.isna(vals):
                    continue
            except (ValueError, TypeError):
                pass
            if not _is_listlike(vals):
                continue
            for i, v in enumerate(vals):
                rows.append({
                    "file_name": row["file_name"],
                    "ordinal": i,
                    value_col: str(v) if v is not None else None,
                })
        if rows:
            junction = pd.DataFrame(rows)
            junction.to_sql(table_name, conn, index=False, if_exists="replace")
            conn.execute(f"CREATE INDEX idx_{table_name}_file ON {table_name}(file_name)")
    
    explode_to_junction("ilsa_context__assessments_used", "article_assessments", "assessment")
    explode_to_junction("ilsa_context__countries_analyzed", "article_countries", "country")
    explode_to_junction("ilsa_context__assessment_cycles", "article_cycles", "cycle")
    explode_to_junction("ml_methodology__algorithms_used", "article_algorithms", "algorithm")
    explode_to_junction("xai__xai_methods", "article_xai_methods", "method")
    explode_to_junction("xai__top_features_identified", "article_top_features", "feature")
    explode_to_junction("performance__classification_metrics", "article_classification_metrics", "metric")
    explode_to_junction("performance__regression_metrics", "article_regression_metrics", "metric")
    explode_to_junction("findings__key_findings", "article_findings", "finding")
    explode_to_junction("findings__policy_recommendations", "article_policies", "recommendation")
    explode_to_junction("findings__inequality_dimensions_addressed", "article_inequality_dimensions", "dimension")
    explode_to_junction("findings__target_decision_makers", "article_decision_makers", "decision_maker")
    explode_to_junction("findings__limitations_acknowledged", "article_limitations", "limitation")
    explode_to_junction("bibliographic__authors", "article_authors", "author")
    
    conn.commit()
    conn.close()
    logger.info(f"Built SQLite database at {db_path}")
