    "main_findings": [
      {
        "dataset_used": "PISA 2022 (Spain) student data (15-year-olds), clustering + cluster classification",
        "target_variable": "Student cluster membership (7 clusters)",
        "top_predictors": [
          "Socioeconomic status (ESCS)",
          "ICT availability at home",
          "ICT availability at school"
        ],
        "performance_metrics": "k-means clustering (7 clusters) + best classification pipeline — global accuracy: 0.8643 (test set); precision: 0.8401–0.9321; recall: 0.8055–0.9406",
        "standardized_conclusion": "Using PISA 2022 (Spain) student the study leveraged socioeconomic status (ESCS) and ICT availability at home and school to predict student cluster membership (7 clusters), finding that ESCS and ICT-use variables had the highest predictive power and that the best model achieved global accuracy of 0.8643 on the test set. This indicates that combining socioeconomic context with ICT access/use can support interpretable student profiling for more targeted, profile-specific educational and well-being interventions, though the clustering-to-classification approach is not causal and may be sensitive to the (undocumented) missing-data procedure."
      }
    ],
    "outcome_summary": "The study applies an explainable cluster analysis pipeline to PISA 2022 Spanish student data (15-year-olds), using the full sample (n = 30,800) and 74 student-context variables transformed into 16 derived variables. It performs k-means clustering to obtain an optimal solution of 7 student clusters, then compares classification pipelines to label/interpret clusters, using SHAP for global and local interpretability. The best-performing classification model reaches global accuracy of 0.8643 on the test set, with precision ranging from 0.8401 to 0.9321 and recall from 0.8055 to 0.9406. The most predictive features for cluster categorization are ESCS and ICT use at home and school, and the authors report cluster differences in gender patterns, academic performance, and educational expectations. A key limitation is that the paper does not document the missing-data handling strategy, and SHAP-based feature importance supports prediction interpretability rather than causal claims.",
    "research_design_type": "predictive",
    "null_fields_interpretation": null
  }
