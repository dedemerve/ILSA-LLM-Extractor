    "main_findings": [
      {
        "dataset_used": "PISA 2018 (age 15y3m–16y2m), academic performance (AP) derived from PVs (Mathematics/Reading/Science/Global Competence)",
        "target_variable": "Academic performance (AP) categories A–D",
        "top_predictors": [
          "Reading skills and habits item (ST013Q01TA)",
          "Reading skills and habits item (ST161Q06HA)",
          "Reading skills and habits item (ST154Q01HA)",
          "Home learning environment item (ST011Q04TA)",
          "Career goals item (EC153Q02HA)"
        ],
        "performance_metrics": "Gradient Boosted Trees (GBT) — Accuracy: 73.7%, Precision: 72.8%, Recall: 88.3% (26-attribute model); with expanded attributes: 73.37% (46 attributes) and 74.17% (74 attributes).",
        "standardized_conclusion": "Using PISA 2018 the study leveraged reading skills and habits, home learning environment, and career goals/mindset variables to predict academic performance categories (A–D) derived from PISA plausible values, finding that Gradient Boosted Trees outperformed the other tested classifiers with the highest accuracy (73.7%) and recall (88.3%). This indicates that institutions can use internationally comparable student background and reading-related indicators to build practical early-warning tools for identifying students at risk of lower academic performance, though the reported performance is based on a random train/test split and the paper does not document complex-survey weighting or PV-combining details for the derived AP."
      }
    ],
    "outcome_summary": "The study uses PISA 2018 microdata (612,004 students aged 15y3m–16y2m from 79 countries) and constructs an academic performance (AP) outcome by discretizing plausible values across Mathematics, Reading, Science, and Global Competence into four categories (A–D). It then trains multiple supervised classification algorithms in RapidMiner to predict AP from 26 selected questionnaire-derived predictors spanning gender, home learning environment, family background, reading skills/habits, career goals/mindset, and mental health. Across models, Gradient Boosted Trees achieved the best performance with Accuracy = 73.7%, Precision = 72.8%, and Recall = 88.3% (and improved to 74.17% accuracy when expanding to 74 attributes). The top predictors by feature importance were reading skills/habits items (including books at home) followed by home learning environment and career goals. Limitations include the use of a random 80/20 split without reported nested cross-validation, unclear handling of PISA plausible values beyond PV-based discretization, and no explicit use of PISA sampling/replicate weights, which may affect generalizability and uncertainty under the clustered survey design.",
    "research_design_type": "predictive",
